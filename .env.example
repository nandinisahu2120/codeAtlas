# ========================================================
# codeAtlas Environment Configuration Template
# ========================================================

# Number of OpenMP threads (keep 1 to prevent CPU contention)
OMP_NUM_THREADS=1

# Allow multiple OpenMP runtimes without aborting
KMP_DUPLICATE_LIB_OK=TRUE

# Disable HuggingFace tokenizer parallelism warnings
TOKENIZERS_PARALLELISM=false

# Streamlit Port Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=false

